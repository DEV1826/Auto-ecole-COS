generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id           Int      @id @default(autoincrement())
  nom          String
  prenom       String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("utilisateurs")
}

model Candidat {
  id              Int                 @id @default(autoincrement())
  nom             String
  prenom          String
  email           String?             @unique
  telephone       String?
  dateNaissance   DateTime?
  adresse         String?
  numeroPermis    String?             @unique
  categorie       CategoriePermis     @default(B)
  statut          StatutCandidat      @default(EN_COURS)
  dateInscription DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  paiements       Paiement[]
  lecons          Lecon[]
  examens         Examen[]
  factures        Facture[]
  formation       FormationCandidat?

  @@map("candidats")
}

model Formation {
  id             Int                 @id @default(autoincrement())
  nom            String
  description    String?
  prixTotal      Float
  heuresCode     Int                 @default(0)
  heuresConduite Int                 @default(20)
  categorie      CategoriePermis     @default(B)
  actif          Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  candidats      FormationCandidat[]

  @@map("formations")
}

model FormationCandidat {
  id                       Int       @id @default(autoincrement())
  candidatId               Int       @unique
  formationId              Int
  heuresCodeEffectuees     Int       @default(0)
  heuresConduiteEffectuees Int       @default(0)
  montantTotal             Float
  dateDebut                DateTime  @default(now())
  dateFin                  DateTime?
  candidat                 Candidat  @relation(fields: [candidatId], references: [id])
  formation                Formation @relation(fields: [formationId], references: [id])

  @@map("formation_candidats")
}

model Moniteur {
  id           Int       @id @default(autoincrement())
  nom          String
  prenom       String
  email        String?   @unique
  telephone    String?
  specialite   String?
  dateEmbauche DateTime?
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lecons       Lecon[]

  @@map("moniteurs")
}

model Vehicule {
  id                   Int             @id @default(autoincrement())
  immatriculation      String          @unique
  marque               String
  modele               String
  annee                Int
  categorie            CategoriePermis @default(B)
  kilometrage          Int             @default(0)
  dateAcquisition      DateTime?
  dateDerniereRevision DateTime?
  prochaineRevision    Int?
  statut               StatutVehicule  @default(DISPONIBLE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lecons               Lecon[]
  entretiens           Entretien[]
  depenses             Depense[]

  @@map("vehicules")
}

model Lecon {
  id         Int         @id @default(autoincrement())
  date       DateTime
  duree      Int         @default(60)
  type       TypeLecon   @default(CONDUITE)
  statut     StatutLecon @default(PLANIFIEE)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  candidatId Int
  moniteurId Int
  vehiculeId Int?
  candidat   Candidat    @relation(fields: [candidatId], references: [id])
  moniteur   Moniteur    @relation(fields: [moniteurId], references: [id])
  vehicule   Vehicule?   @relation(fields: [vehiculeId], references: [id])

  @@map("lecons")
}

model Examen {
  id         Int            @id @default(autoincrement())
  date       DateTime
  type       TypeExamen
  resultat   ResultatExamen @default(EN_ATTENTE)
  note       Float?
  centre     String?
  notes      String?
  createdAt  DateTime       @default(now())
  candidatId Int
  candidat   Candidat       @relation(fields: [candidatId], references: [id])

  @@map("examens")
}

model Paiement {
  id         Int          @id @default(autoincrement())
  montant    Float
  date       DateTime     @default(now())
  mode       ModePaiement @default(ESPECES)
  reference  String?
  note       String?
  createdAt  DateTime     @default(now())
  candidatId Int
  factureId  Int?
  candidat   Candidat     @relation(fields: [candidatId], references: [id])
  facture    Facture?     @relation(fields: [factureId], references: [id])

  @@map("paiements")
}

model Depense {
  id          Int               @id @default(autoincrement())
  categorie   CategorieDepense
  montant     Float
  description String?
  date        DateTime          @default(now())
  fournisseur String?
  reference   String?
  createdAt   DateTime          @default(now())
  vehiculeId  Int?
  vehicule    Vehicule?         @relation(fields: [vehiculeId], references: [id])

  @@map("depenses")
}

model Caisse {
  id          Int           @id @default(autoincrement())
  type        TypeMouvement
  montant     Float
  solde       Float
  description String?
  reference   String?
  date        DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@map("caisse")
}

model Facture {
  id           Int            @id @default(autoincrement())
  numero       String         @unique
  montantTotal Float
  statut       StatutFacture  @default(EN_ATTENTE)
  dateEmission DateTime       @default(now())
  dateEcheance DateTime?
  pdfPath      String?
  notes        String?
  createdAt    DateTime       @default(now())
  candidatId   Int
  candidat     Candidat       @relation(fields: [candidatId], references: [id])
  paiements    Paiement[]

  @@map("factures")
}

model Entretien {
  id          Int      @id @default(autoincrement())
  type        String
  description String?
  cout        Float?
  kilometre   Int?
  date        DateTime @default(now())
  prochainKm  Int?
  createdAt   DateTime @default(now())
  vehiculeId  Int
  vehicule    Vehicule @relation(fields: [vehiculeId], references: [id])

  @@map("entretiens")
}

enum Role {
  ADMIN
  SECRETAIRE
  MONITEUR
}

enum CategoriePermis {
  A
  B
  C
  D
  BE
}

enum StatutCandidat {
  EN_COURS
  RECU
  ECHOUE
  ABANDONNE
  EN_ATTENTE
}

enum StatutVehicule {
  DISPONIBLE
  EN_LECON
  EN_ENTRETIEN
  HORS_SERVICE
}

enum TypeLecon {
  CODE
  CONDUITE
  CONDUITE_ACCOMPAGNEE
}

enum StatutLecon {
  PLANIFIEE
  EFFECTUEE
  ANNULEE
  ABSENCE
}

enum TypeExamen {
  CODE
  CONDUITE
}

enum ResultatExamen {
  EN_ATTENTE
  RECU
  AJOURNE
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE
  MOBILE_MONEY
}

enum CategorieDepense {
  CARBURANT
  ENTRETIEN_VEHICULE
  SALAIRE
  LOYER
  ELECTRICITE
  TELEPHONE
  ASSURANCE
  PUBLICITE
  FOURNITURES
  TAXES
  AUTRE
}

enum TypeMouvement {
  ENTREE
  SORTIE
}

enum StatutFacture {
  EN_ATTENTE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}
